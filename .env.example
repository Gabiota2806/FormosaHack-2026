# Entorno
ENVIRONMENT=development

# Base de Datos PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=formosahack
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/formosahack

# Seguridad & JWT
JWT_SECRET=formosahack_jwt_secret_dev_key_2026_not_for_prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:8000,http://localhost:3000

# Web Push (VAPID) — generar con: python -c "from py_vapid import Vapid01; v=Vapid01(); v.generate_keys(); print(v.public_key_urlsafe_base64(), v.private_key_urlsafe_base64())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=admin@ciberguardian.gob.ar

# Puertos Internos
AUTH_SERVICE_PORT=8001
CORE_SERVICE_PORT=8002
GATEWAY_PORT=8000
FRONTEND_PORT=5173

# Integración con Jira Cloud
JIRA_INSTANCE_URL=https://tu-organizacion.atlassian.net
JIRA_EMAIL=tu-email@gmail.com
JIRA_API_TOKEN=tu_api_token_de_atlassian
JIRA_PROJECT_KEY=FH26
