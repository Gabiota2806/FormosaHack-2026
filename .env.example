# Entorno
ENVIRONMENT=development

# Base de Datos PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=formosahack
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/formosahack

# Seguridad & JWT
JWT_SECRET=formosahack_jwt_secret_dev_key_2026_not_for_prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:8000,http://localhost:3000

# Web Push (VAPID) — generar con:
# python -c "import base64; from cryptography.hazmat.primitives import serialization as s; from py_vapid import Vapid; v=Vapid(); v.generate_keys(); print('PUBLIC='+base64.urlsafe_b64encode(v.public_key.public_bytes(s.Encoding.X962, s.PublicFormat.UncompressedPoint)).decode().rstrip('=')); print('PRIVATE='+base64.urlsafe_b64encode(v.private_key.private_bytes(s.Encoding.DER, s.PrivateFormat.PKCS8, s.NoEncryption())).decode())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=admin@ciberguardian.gob.ar

# Puertos Internos
AUTH_SERVICE_PORT=8001
CORE_SERVICE_PORT=8002
GATEWAY_PORT=8000
FRONTEND_PORT=5173

# Integración con Jira Cloud
JIRA_INSTANCE_URL=https://tu-organizacion.atlassian.net
JIRA_EMAIL=tu-email@gmail.com
JIRA_API_TOKEN=tu_api_token_de_atlassian
JIRA_PROJECT_KEY=FH26

# Integración con Google Gemini
GEMINI_API_KEY=tu_api_key_de_gemini
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT=25.0
